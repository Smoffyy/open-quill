# Copy this file to ".env" in the project root.
#
# OPEN_QUILL_DB selects the database to load at startup. Each database is
# completely isolated (users, chats, files, models, memory, etc.).
# Change this value and restart the server to switch databases.
#
# "default" uses server/data/ (backwards compatible). Any other name lives in
# server/data/databases/<name>/. Names may use lowercase letters, numbers,
# dashes and underscores.
OPEN_QUILL_DB=default

# Port the server listens on.
# PORT=3001

# Network interface the server binds to. Defaults to 127.0.0.1 (this machine
# only). Set to 0.0.0.0 to also allow access from other devices on your LAN.
# HOST=127.0.0.1

# Optional global SQLCipher key. Leave empty to use a per-database key stored
# next to each database's data. If set, it applies to every database.
# 64 hex characters is treated as a raw 32-byte key; anything else is used as a
# passphrase. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_ENCRYPTION_KEY=

# Set this ONLY when a reverse proxy (nginx, Caddy, Traefik, ...) sits in front of
# this server and sets X-Forwarded-For itself. It makes the server read the client
# address from that header for audit logs and login rate limiting.
#
# Leave it off for a directly exposed server: the header is attacker-controlled
# there, so trusting it would let any caller forge audit entries and give itself
# unlimited login attempts by rotating the value.
# TRUST_PROXY=1

# Extra origins allowed to make state-changing requests, comma separated, e.g.
# https://quill.example,https://chat.example. You almost certainly do not need
# this: the browser's own Sec-Fetch-Site header already covers proxied setups.
# Set it only if a proxy in front of this server rewrites the Host header AND
# your browser is old enough not to send that header (Safari below 16.4).
# TRUSTED_ORIGINS=