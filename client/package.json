{
  "name": "open-quill-client",
  "version": "27.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-local.mjs",
    "preview": "vite preview",
    "test": "node --test test/logic.test.js",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "check:local": "node scripts/check-local.mjs",
